@using EightBitWorks.Web.Configuration
@{
    ViewData["Title"] = "Our Courses";
}
@inject IHostConfiguration HostConfiguration

<section id="courses" class="courses-intro-section" style="padding-bottom: 4rem">
    <div class="container">
        <div class="row text-left">
            <h1 class="display-3--title--big fw-bold">Our Courses</h1>
            <div class="d-flex align-items-start">
                <div class="heading-line text-left"></div>
            </div>
            <h2>Specialized Skill Development for Professionals</h2>
            <p class="text-muted">Our Docker and Kubernetes course is meticulously crafted for engineers and teams seeking mastery in containerized application development and orchestration. Gain the skills to streamline deployment, enhance scalability, and revolutionize your software delivery process.</p>
            <p>&nbsp;</p>
            <div>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" class="fas fa-home text-decoration-none"></a></li>
                    <li class="breadcrumb-item active">Courses</li>
                </ol>
            </div>
        </div>
        <div class="row border rounded-1_1">
            <div class="col-lg-20 col-md-20 col-sm-12 col-xs-12 services mt-4 text-center">
                <img src="@HostConfiguration.GetResourceUrl("/images/docker-icon.png")" alt="Docker Technologies Course" class="img-fluid" width="182" height="47">
            </div>
            <div class="col-lg-60 col-md-60 col-sm-12 col-xs-12 services mt-4">
                <a href="/courses/master-in-docker-technologies/">
                    <h3 class="display-3--title mt-1">Master In Docker Technologies</h3>
                </a>
                <p class="lh-lg">
                    Container-based applications like Docker can help you develop software across platforms. Master the configuration and maintenance of the Docker system in our Docker training.
                </p>
            </div>
            <div class="col-lg-20 col-md-20 col-sm-12 col-xs-12 services mt-4 text-end">
                <a href="/courses/master-in-docker-technologies/" class="text-decoration-none">
                    <button class="rounded-pill btn-rounded border-primary">See Details
                        <span><i class="fas fa-arrow-right"></i></span>
                    </button>
                </a>
            </div>
        </div>
        <br/>
        <div class="row border rounded-1_1">
            <div class="col-lg-20 col-md-20 col-sm-12 col-xs-12 services mt-4 text-center">
                <img src="@HostConfiguration.GetResourceUrl("/images/kubernetes-icon.png")" alt="Kubernetes Technologies Course" class="img-fluid" width="100" height="100">   
            </div>
            <div class="col-lg-60 col-md-60 col-sm-12 col-xs-12 services mt-4">
                <a href="/courses/from-zero-to-hero-kubernetes-technologies/">
                    <h3 class="display-3--title mt-1">Docker and Kubernetes: From Zero To Hero</h3>
                </a>
                <p class="lh-lg">
                    Want to learn Docker & Kubernetes? Get an in-depth primer on this powerful system for managing containerized applications. Kubernetes course is designed to enable you to deploy, use, and maintain your applications in Kubernetes.
                </p>
            </div>
            <div class="col-lg-20 col-md-20 col-sm-12 col-xs-12 services mt-4 text-end">
                <a href="/courses/from-zero-to-hero-kubernetes-technologies/" class="text-decoration-none">
                    <button class="rounded-pill btn-rounded border-primary">See Details
                        <span><i class="fas fa-arrow-right"></i></span>
                    </button>
                </a>
            </div>
        </div>
        <br/>
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 services mt-2 text-center">
                <div class="text-center d-grid mt-1">
                    <h2>Take a look at our Course Brochure</h2>
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 services mt-2 text-center">
                        <a href="/download/Docker-Kubernetes-Course-Outline.pdf" class="btn btn-primary rounded-pill pt-3 pb-3 px-4">
                            Download Course Brochure &nbsp; <i class="fas fa-download"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</section>

@section NaviationBar
{
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" aria-current="page" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link active" href="/courses/">Courses</a></li>
        <li class="nav-item"><a class="nav-link" href="/about-the-author/">About Us</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact-us/">Contact Us</a></li>
    </ul>
}

@section JsonLd
{
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ItemList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "item": {
            "@@type": "Course",
            "url": "https://eightbitworks.com/courses/master-in-docker-technologies/",
            "name": "Master In Docker Technologies",
            "description": "This is an expert level Docker training course that helps you to build container-based applications. This course on Docker technologies can help you develop software across platforms. Master the configuration, deployment, and maintenance of the Docker system in our Docker training course.",
            "provider": {
              "@@type": "Organization",
              "name": "EightBitWorks",
              "sameAs": "https://eightbitworks.com"
            }
          }
        },
        {
          "@@type": "ListItem",
          "position": 2,
          "item": {
            "@@type": "Course",
            "url": "https://eightbitworks.com/courses/from-zero-to-hero-kubernetes-technologies/",
            "name": "Docker And Kubernetes: From Zero To Hero",
            "description": "Become an expert in implementing and maintaining Kubernetes platform applications with this Docker and Kubernetes training course. Gain an in-depth understanding of container orchestration platform Kubernetes and master in application deployment, maintainability, scalability, and security.",
            "provider": {
              "@@type": "Organization",
              "name": "EightBitWorks",
              "sameAs": "https://eightbitworks.com"
            }
          }
        }
      ]
    }
    </script>
}