          <div class="campanies__logo-box shadow-sm">
            <img src="images/campanies/logo_auk.png" alt="AUK logo" title="AUK Logo" class="img-fluid">
          </div>
        </div>
        <div class="col-md-4 col-lg-2">
          <div class="campanies__logo-box shadow-sm">
            <img src="images/campanies/logo_gulfbank.png" alt="Gulf Bank logo" title="Gulf Bank Logo" class="img-fluid">
