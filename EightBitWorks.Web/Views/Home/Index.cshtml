@{
    ViewData["Title"] = "Home";
}


@section NaviationBar
{
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link active" aria-current="page" href="/home">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/courses">Courses</a></li>
    </ul>
