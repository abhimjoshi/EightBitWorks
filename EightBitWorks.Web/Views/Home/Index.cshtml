@using EightBitWorks.Web.Configuration
@{
    ViewData["Title"] = "Expert training on Docker & Kubernetes"; 
}
@inject IHostConfiguration HostConfiguration

<section id="home" class="intro-section">
  <div class="container">
    <div class="row align-items-center text-white">
      <!-- START THE CONTENT FOR THE INTRO  -->
      <div class="col-md-6 intros text-start">
        <h1 class="display-2">
          <span class="display-2--intro"><h1>Become an expert in </h1>Docker & Kubernetes</span>
          <span class="display-2--description lh-base">
            Experience shared by the real professional expert for the real technology needs
          </span>
        </h1>
        <a href="/courses/" class="text-decoration-none">
            <button type="button" class="rounded-pill btn-rounded">See Courses
                <span><i class="fas fa-arrow-right"></i></span>
            </button>
        </a>
      </div>
      <!-- START THE CONTENT FOR THE VIDEO -->
      <div class="col-md-6 intros text-end">
        <div class="video-box">
          <img src="@HostConfiguration.GetResourceUrl("/images/arts/intro-section-illustration.png")" alt="video illutration" class="img-fluid">
          <!-- <a href="#" class="glightbox position-absolute top-50 start-50 translate-middle">
            <span>
              <i class="fas fa-play-circle"></i>
            </span>
            <span class="border-animation border-animation--border-1"></span>
            <span class="border-animation border-animation--border-2"></span>
          </a> -->
        </div>
      </div>
    </div>
  </div>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 319"><path fill="#ffffff" fill-opacity="1" d="M0,160L48,176C96,192,192,224,288,208C384,192,480,128,576,133.3C672,139,768,213,864,202.7C960,192,1056,96,1152,74.7C1248,53,1344,107,1392,133.3L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>
</section>

<section id="campanies" class="campanies">
  <div class="container">
    <div class="row text-center">
      <h4 class="fw-bold lead mb-3">Trusted by campanies like</h4>
      <div class="heading-line mb-5"></div>
    </div>
  </div>
  <!-- START THE CAMPANIES CONTENT  -->
  <div class="container">
    <div class="row">
      <div class="col-md-4 col-lg-2">
        <div class="campanies__logo-box shadow-sm">
          <img src="@HostConfiguration.GetResourceUrl("/images/companies/logo_fidelity.png")" alt="Fidelity logo" title="Fidelity logo" class="img-fluid">
        </div>
      </div>
      <div class="col-md-4 col-lg-2">
        <div class="campanies__logo-box shadow-sm">
          <img src="@HostConfiguration.GetResourceUrl("/images/companies/logo_intuit.png")" alt="Intuit logo" title="Intuit" class="img-fluid">
        </div>
      </div>
      <div class="col-md-4 col-lg-2">
        <div class="campanies__logo-box shadow-sm">
          <img src="@HostConfiguration.GetResourceUrl("/images/companies/logo_auk.png")" alt="AUK logo" title="American University of Kuwait" class="img-fluid">
        </div>
      </div>
      <div class="col-md-4 col-lg-2">
        <div class="campanies__logo-box shadow-sm">
          <img src="@HostConfiguration.GetResourceUrl("/images/companies/logo_gulfbank.png")" alt="Gulf Bank logo" title="Gulf Bank" class="img-fluid">
        </div>
      </div>
      <div class="col-md-4 col-lg-4">
        <div class="campanies__logo-box shadow-sm">
          <img src="@HostConfiguration.GetResourceUrl("/images/companies/logo_a1ig.png")" alt="A1IG logo" title="A1IG" class="img-fluid">
        </div>
      </div>
    </div>
  </div>
</section>
<section id="services" class="services">
  <div class="container">
    <div class="row text-center">
      <h1 class="display-3 fw-bold">We just do one thing, really well</h1>
      <div class="heading-line mb-1"></div>
    </div>
  <!-- START THE DESCRIPTION CONTENT  -->
    <div class="row pt-2 pb-2 mt-0 mb-3">
      <div class="col-md-6 border-right">
        <div class="bg-white p-3">
          <h2 class="fw-bold text-center">
             We deliver technical skill for today’s professionals on tomorrow’s technology.
          </h2>
        </div>
      </div>
      <div class="col-md-6">
        <div class="bg-white p-4 text-start">
          <p class="fw-light">
            For EightBitWorks, helping people gain Docker & Kubernetes skills and knowledge isn’t only a commitment, but also a passion.
            Our teaching range from basic level to advance learning.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- START THE CONTENT FOR THE SERVICES  -->
  <div class="container">
    <!-- START THE MARKETING CONTENT  -->
    <div class="row">
      <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 services mt-4">
        <div class="services__content">
          <div class="icon d-block fas fa-paper-plane"></div>
          <h3 class="display-3--title mt-1">Customized Training For Engineering Team</h3>
          <p class="lh-lg">
            We work closely with engineering teams at different companies to understand their unique challenges and goals. By conducting pre-assessments and incorporating industry-specific case studies and exercises, We deliver content that directly addresses their requirements. 
          </p>
          <a href="/about-the-author/" class="text-decoration-none">
              <button type="button" class="rounded-pill btn-rounded border-primary">Know About Us
                  <span><i class="fas fa-arrow-right"></i></span>
              </button>
          </a>
        </div>
      </div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 services mt-4 text-end">
        <div class="services__pic">
          <img src="@HostConfiguration.GetResourceUrl("/images/services/service-1.png")" alt="marketing illustration" class="img-fluid">
        </div>
      </div>
    </div>
    <!-- START THE WEB DEVELOPMENT CONTENT  -->
    <div class="row">
      <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 services mt-4 text-start">
        <div class="services__pic">
          <img src="@HostConfiguration.GetResourceUrl("/images/services/service-2.png")" alt="web development illustration" class="img-fluid">
        </div>
      </div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 services mt-4">
        <div class="services__content">
          <div class="icon d-block fas fa-code"></div>
          <h3 class="display-3--title mt-1">Organizational Excellence</h3>
          <p class="lh-lg">
            Empowering your workforce to keep pace with ever evolving market through our customized technical skills training workshops.
          </p>
          <p class="lh-lg">
            We ensure that participants gain practical, hands-on experience with Docker and Kubernetes, enabling them to seamlessly integrate these technologies into their existing workflows and achieve optimal results in their development projects. A customized training to fit your company’s unique needs and conveniently delivered on-site or virtually.
            </p>
          <a href="#contact" class="text-decoration-none">
              <button type="button" class="rounded-pill btn-rounded border-primary">Contact Us
                  <span><i class="fas fa-arrow-right"></i></span>
              </button>
          </a>
        </div>
      </div>
    </div>
    <!-- START THE CLOUD HOSTING CONTENT  -->
    <div class="row">
      <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 services mt-4">
        <div class="services__content">
          <div class="icon d-block fas fa-cloud-upload-alt"></div>
          <h3 class="display-3--title mt-1">Actionable Knowledge</h3>
          <p class="lh-lg">
            Our training programs go beyond theory, providing participants with hands-on, practical skills that can be immediately applied in real-world scenarios. We believe in delivering knowledge that translates directly into action. Through interactive labs and industry-relevant case studies, we equip your team with the tools and expertise they need to excel in Docker and Kubernetes technologies.
          </p>
          <a href="/courses/" class="text-decoration-none">
              <button type="button" class="rounded-pill btn-rounded border-primary">Check Our Courses
                  <span><i class="fas fa-arrow-right"></i></span>
              </button>
          </a>
        </div>
      </div>
      <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 services mt-4 text-end">
        <div class="services__pic">
          <img src="@HostConfiguration.GetResourceUrl("/images/services/service-3.png")" alt="cloud hosting illustration" class="img-fluid">
        </div>
      </div>
    </div>
  </div>
</section>
<section id="contact" class="get-started">
  <div class="container">
    <div class="row text-center">
      <h1 class="display-3 fw-bold text-capitalize">Get started</h1>
      <div class="heading-line"></div>
      <p class="lh-lg">
        Reach out to us now and let's get started on designing a customized training program tailored to your team's needs.
      </p>
    </div>

    <!-- START THE CTA CONTENT  -->
    <div class="row text-white">
      <div class="col-12 col-lg-6 gradient shadow p-3">
        <div class="cta-info w-100">
          <h4 class="display-4 fw-bold">100% Satisfaction Guaranteed</h4>
          <p class="lh-lg">
            Your satisfaction is our top priority. We are confident in the quality of our training programs and the expertise we offer. That's why we offer a 100% Satisfaction Guarantee. 
          </p>
          <p>
            Join us with the assurance that your learning journey is backed by our unwavering commitment to your satisfaction.
          </p>
          <h3 class="display-3--brief">What will be the next step?</h3>
          <ul class="cta-info__list">
            <li>Ensure a timely response within a day.</li>
            <li>Ask for specific details about your Docker and Kubernetes training needs.</li>
            <li>Get course structure, schedules and pricing based on your objectives and requirements.</li>
          </ul>
        </div>
      </div>
      <div class="col-12 col-lg-6 bg-white shadow p-3">
        <div class="form w-100 pb-2">
          <h4 class="display-3--title mb-5">start your learning</h4>
          <form action="/contactus" class="row" enctype="multipart/form-data" method="post">
            @Html.AntiForgeryToken()
            <div class="col-lg-6 col-md mb-3">
              <input name="name" type="text" placeholder="First Name" required="required" maxlength="60" id="inputFirstName" class="shadow form-control form-control-lg">
            </div>
            <div class="col-lg-6 col-md mb-3">
              <input name="company" type="text" placeholder="Company Name" maxlength="100" id="inputLastName" class="shadow form-control form-control-lg">
            </div>
            <div class="col-lg-12 mb-3">
              <input name="fromEmail" type="email" placeholder="email address" required="required" maxlength="60" id="inputEmail" class="shadow form-control form-control-lg">
            </div>
            <div class="col-lg-12 mb-3">
              <textarea name="message" placeholder="message" id="message" required="required" rows="8" maxlength="3000" class="shadow form-control form-control-lg"></textarea>
            </div>
            <div class="text-center d-grid mt-1">
              <button type="submit" class="btn btn-primary rounded-pill pt-3 pb-3">
                submit
                <i class="fas fa-paper-plane"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

@section NaviationBar
{
    <ul class="navbar-nav">
      <li class="nav-item"><a class="nav-link active" aria-current="page" href="/">Home</a></li>
      <li class="nav-item"><a class="nav-link" href="/courses/">Courses</a></li>
      <li class="nav-item"><a class="nav-link" href="/about-the-author/">About Us</a></li>
      <li class="nav-item"><a class="nav-link" href="/contact-us/">Contact Us</a></li>
    </ul>
}

