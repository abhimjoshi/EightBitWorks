@{
    ViewData["Title"] = "Thank you";
}

<style>
    .no-text-decoration
    {
        text-decoration: none !important;
    }
</style>

@section NaviationBar
{
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link active" aria-current="page" href="/home/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/courses/">Courses</a></li>
        <li class="nav-item"><a class="nav-link" href="/about-the-author/">About Us</a></li>
    </ul>
}

<section id="courses" class="courses-intro-section" style="padding-bottom: 4rem">
    <div class="container">
        <div class="row">
            <h1 class="display-3--title--big fw-bold">Thank you!</h1>
            <div class="d-flex align-items-start">
                <div class="heading-line text-left"></div>
            </div>
            <div class="col-lg-6 mt-3">
                <h2>We have received your email and will get back to you at earliest.</h2>
                <div class="mt-3 text-muted">
                    <p class="text-muted">This is your official confirmation. Thank you for contacting us, and while you wait for our reply back, check out the Docker and Kubernetes courses.</p>
                    <p class="text-muted">&nbsp;</p>
                    <p class="text-muted">
                        <a href="/courses/" class="text-decoration-none">
                            <button class="rounded-pill btn-rounded border-primary">Explore Courses
                                <span><i class="fas fa-arrow-right"></i></span>
                            </button>
                        </a>
                    </p>
                </div>
            </div>
            <div class="col-lg-6 mt-3 text-center">
                <div class="services__pic">
                    <img src="/images/ThankYou.png" alt="marketing illustration" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

