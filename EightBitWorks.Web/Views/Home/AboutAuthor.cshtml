                <div class="mt-3 text-muted">
                    <p class="my-2"><span class="fab fa-linkedin">&nbsp;</span><span class="mx-2"><a class="no-text-decoration" target="_blank" href="https://linkedin.com/in/abhimjoshi">LinkedIn</a></span></p>
                    <p class="my-2"><span class="fab fa-twitter">&nbsp;</span><span class="mx-2"><a class="no-text-decoration" target="_blank" href="https://twitter.com/abhimjoshi">Twitter</a></span></p>
                </div>
